{
  "name": "@selo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "consent:grant": "tsx --env-file-if-exists=.env src/scripts/grant-consent.ts",
    "verify:g1": "tsx src/tools/verify-g1.ts",
    "pay:selo": "tsx --env-file-if-exists=.env src/tools/pay-selo.ts",
    "account:new": "tsx src/tools/testnet-account.ts",
    "account:optin": "tsx --env-file-if-exists=.env src/tools/account-optin.ts",
    "account:status": "tsx --env-file-if-exists=.env src/tools/account-status.ts",
    "testnet:target": "tsx --env-file-if-exists=.env src/tools/testnet-target/server.ts"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@selo/core": "workspace:*",
    "@x402/avm": "2.27.0",
    "@x402/core": "2.27.0",
    "@x402/extensions": "2.27.0",
    "@x402/hono": "2.27.0",
    "algosdk": "3.8.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "postgres": "3.4.9",
    "undici": "7.30.0",
    "zod": "4.6.5"
  }
}
